[Unit]
Description=Meeting Manager Django application
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=meetingapp
Group=www-data
WorkingDirectory=/opt/meeting-manager
EnvironmentFile=/etc/meeting-manager.env
ExecStart=/opt/meeting-manager/.venv/bin/gunicorn --workers 3 --bind 0.0.0.0:8000 config.wsgi:application
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/meeting-manager/media /opt/meeting-manager/staticfiles

[Install]
WantedBy=multi-user.target
