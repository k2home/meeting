#!/usr/bin/env bash
set -euo pipefail

if [[ "$EUID" -ne 0 ]]; then
  echo "Dieser Befehl muss über sudo aufgerufen werden." >&2
  exit 1
fi
if [[ "$#" -ne 1 || ( "$1" != "beta" && "$1" != "main" ) ]]; then
  echo "Verwendung: meeting-manager-update beta|main" >&2
  exit 2
fi

# Run outside the Django service cgroup. The application restarts during an
# update; a transient systemd service keeps the updater alive across that restart.
exec /usr/bin/systemd-run --quiet --collect --unit=meeting-manager-update \
  /usr/local/sbin/meeting-manager-update-runner "$1"
