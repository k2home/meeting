SECRET_KEY=replace-with-a-long-random-secret
# Required for the first browser setup only. Generate with: openssl rand -hex 32
SETUP_TOKEN=replace-with-a-random-one-time-setup-code
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,meeting.intern
POSTGRES_DB=meeting_manager
POSTGRES_USER=meetingapp
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
TIME_ZONE=Europe/Berlin

CSRF_TRUSTED_ORIGINS=https://meeting.example.invalid
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
TRUST_PROXY_SSL=0
USE_X_FORWARDED_HOST=0
SECURE_HSTS_SECONDS=0
# Enable only if every subdomain is permanently HTTPS-only.
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# Requires HTTPS redirection, include_subdomains=1 and at least 31536000 seconds.
SECURE_HSTS_PRELOAD=0
